# Environment Configuration — FraudShield AI

# Application
PROJECT_NAME="FraudShield AI"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
SECRET_KEY="change_this_super_secret_jwt_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fraudshield
POSTGRES_PASSWORD=fraudshield_secret_pass
POSTGRES_DB=fraudshield_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# AI Copilot (Gemini API - Backend Only)
GEMINI_API_KEY=your_gemini_api_key_here

# Risk Engine Thresholds
RISK_THRESHOLD_MEDIUM=30
RISK_THRESHOLD_HIGH=70
