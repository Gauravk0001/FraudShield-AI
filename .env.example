# Environment Configuration — FraudShield AI (Hack2Ignite Release)

# Application
PROJECT_NAME="FraudShield AI"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL - SQLite fallback used in development if unset)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fraudshield
POSTGRES_PASSWORD=replace-with-secure-password
POSTGRES_DB=fraudshield_db

# Redis (Event publishing & caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# AI Copilot (Gemini API - Backend Only; local deterministic fallback used if empty)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Risk Engine Thresholds
RISK_THRESHOLD_MEDIUM=30
RISK_THRESHOLD_HIGH=70
